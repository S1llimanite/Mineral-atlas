# 矿物图鉴环境变量模板
# 复制为 .env.local 后填写真实值

# 数据库（未来接入 PostgreSQL 时启用）
# DATABASE_URL=postgresql://user:pass@localhost:5432/mineral_atlas

# 资产存储
# ASSETS_DIR=./public/models
# MICROGRAPHS_DIR=./public/micrographs

# Blender 可执行文件路径（资产流水线脚本使用）
# BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 4.2/blender.exe

# 来源数据版本
MINERAL_LIST_VERSION=2024-01-IMA-RRUFF